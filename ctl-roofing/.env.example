# ── Per-client environment ─────────────────────────────────────────
# Copy to .env.local for local work, and mirror every value into
# Cloudflare Pages → Settings → Environment variables (Production AND
# Preview) or the deployed site will behave differently from your
# machine.
#
# All values here are PUBLIC — this is a static export, so anything
# prefixed NEXT_PUBLIC_ is compiled into the JavaScript the browser
# downloads. Never put a real secret in this file. Secrets belong in
# whatever server receives these requests, not in the site.

# ── Email: where the assessment request lands ──────────────────────
# REQUIRED. Without it the form refuses to submit and tells the visitor
# to phone instead, which is the honest failure — the alternative is
# silently losing leads.
#
# Get the key from web3forms.com for the office inbox. Web3Forms access
# keys are designed to sit in client-side code: the key names the
# destination inbox and grants no account access, which is why it is
# publishable at all. Publishable is not the same as private, though —
# rotate it from their dashboard if it starts drawing spam, and turn on
# their spam protection before reaching for anything more elaborate.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Optional. Only set this to point somewhere other than Web3Forms.
# Defaults to https://api.web3forms.com/submit
NEXT_PUBLIC_FORM_ENDPOINT=

# ── CRM: the second copy of the lead ───────────────────────────────
# The lead relay's /lead route — workers/lead-relay in this repo. It
# stores every enquiry in a D1 table and forwards it to whichever CRM is
# configured on the Worker, so assessment requests and job applications
# end up in one list instead of an inbox and a bucket.
#
#   https://ctl-lead-relay.<account>.workers.dev/lead
#
# Fired in parallel with the Web3Forms email and never awaited, so a
# relay or CRM outage cannot cost you the email or show the customer an
# error. The relay stores before it forwards, so a CRM being down delays
# a delivery rather than losing a lead.
#
# Optional. Unset, the site behaves exactly as it did before the relay
# existed: the email still goes out and nothing is collected centrally.
#
# NOTE: the CRM itself is configured on the WORKER, not here — see
# workers/lead-relay/README.md. Nothing about which CRM was chosen
# belongs in the JavaScript the browser downloads.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# ── Analytics ──────────────────────────────────────────────────────
# Plausible domain, e.g. ctlpro.com. Leave empty to disable analytics
# entirely. The script only loads after the visitor accepts cookies.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Google reviews (live, client-side) ─────────────────────────────
# Optional. Unset, the reviews page and the home band fall back to a
# link to the Google listing — honest, just less persuasive.
#
# Both values are needed. A wrong place ID would show a DIFFERENT
# business's reviews under CTL's name, so verify it before shipping.
#
# The key: Google Cloud console → enable "Places API (New)" → create an
# API key → restrict it to HTTP referrers (ctlpro.com/*, the
# *.pages.dev preview domain, and localhost for dev) and to the Places
# API alone. Referrer-restricted keys are meant to be public; this one
# is compiled into the JavaScript like everything else here.
#
# The place ID: developers.google.com/maps/documentation/places/web-service/place-id
# → Place ID Finder, search "CTL Roofing, Broussard LA". It should
# resolve to the listing at CID 15642542889135230940. A place ID looks
# like ChIJ… — it is NOT the CID and not the /g/ feature ID.
#
# Cost: one Place Details call per page view that shows reviews.
# Watch it for a week after launch and set a budget alert — this is the
# only thing on the site that bills per visitor.
NEXT_PUBLIC_GOOGLE_PLACES_KEY=
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# ── Careers: where a résumé goes ───────────────────────────────────
# The deployed URL of workers/careers-upload in this repo. A static
# export cannot receive a file, so this Worker is the only server-side
# piece of the site — it validates the upload and writes it to a
# private R2 bucket.
#
# Unset, the application form refuses to submit and points people at
# the office email. That is deliberate: somebody applying for a job has
# put real work into that document, and a form that appears to take it
# and drops it costs them a job they think they applied for.
#
# Deploy: cd workers/careers-upload && npm i && npx wrangler deploy
# Then paste the workers.dev URL (or the custom route) here.
#
# To have applications join the leads in one list, set two secrets on
# that Worker so it pings the relay:
#   wrangler secret put NOTIFY_WEBHOOK       # https://<relay>/application
#   wrangler secret put RELAY_INGEST_SECRET  # same value as the relay's
#                                            # INGEST_SECRET
NEXT_PUBLIC_CAREERS_ENDPOINT=

# Cloudflare Turnstile site key (the public half). Optional but strongly
# recommended before /careers/ goes live — it is the only thing that
# actually stops a bot filling the R2 bucket. The matching secret goes
# on the Worker with `wrangler secret put TURNSTILE_SECRET`; the Worker
# only enforces the check when that secret exists.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Gallery CMS (build-time, NOT NEXT_PUBLIC_) ──────────────────────
# The GitHub OAuth relay that lets /admin/ sign in and commit. Read by
# scripts/cms.mjs at build time and written into the CMS config; it is
# not compiled into any page.
#
# Unset, /admin/ renders setup instructions instead of a sign-in that
# could not complete. Full walkthrough: docs/GALLERY-CMS.md
#
#   https://ctl-cms-auth.<account>.workers.dev
CMS_AUTH_URL=
