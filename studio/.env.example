# ── The gallery studio ─────────────────────────────────────────────
# Copy to .env. Neither of these is a secret: both appear in every
# image URL the public site serves.

# From sanity.io/manage → the project → Project ID.
SANITY_STUDIO_PROJECT_ID=

# "production" unless you deliberately made a second dataset.
SANITY_STUDIO_DATASET=production

# The subdomain `npm run deploy` publishes to, i.e.
# <hostname>.sanity.studio. Only needed for the first deploy; after
# that the CLI remembers.
SANITY_STUDIO_HOSTNAME=ctl-roofing

# ── The one-off import, and nothing else ───────────────────────────
# A token with WRITE access, used only by `npm run import` to bring the
# forty original photographs in. It is not needed to run or deploy the
# studio, and it is not the token the site build uses — that one is
# read-only. Create it at sanity.io/manage → API → Tokens, use it, then
# delete it.
#
# Never commit a filled-in .env. This file is the example; .env is
# gitignored.
SANITY_IMPORT_TOKEN=
